# ── Database & Application Security ──────────────────────────────────────────
DATABASE_URL=sqlite:///./resume_screening.db
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
UPLOAD_DIR=./uploads
EAGER_TASKS=true

# ── Embedding Model & Scoring Configuration ──────────────────────────────────
# HireRank uses dense sentence embeddings for semantic similarity scoring.
# Leave blank to use the default 'all-MiniLM-L6-v2' model from SentenceTransformers.
# If you train a custom model with python finetune_model.py, specify its path here:
# EMBEDDING_MODEL=./hirerank-finetuned-v1
EMBEDDING_MODEL=

APP_BASE_URL=http://localhost:5173

# ── Outbound Email Delivery Configuration ─────────────────────────────────────
# IMPORTANT: Real email delivery to candidates requires a verified provider below.
# If neither SMTP nor Resend is configured, HireRank logs candidate interview links
# to the local uvicorn console and flags invitations as 'delivery_failed' so you can
# manually copy links during local development.
#
# Option 1: Gmail SMTP (RECOMMENDED - Sends to ANY inbox without domain verification)
# 1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
# 2. Generate an App Password (16 characters): https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the generated 16-character password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Option 2: Resend API (https://resend.com)
# NOTE: The free Resend sandbox ('onboarding@resend.dev') only delivers to your own
# registered Resend account email. To deliver to external candidates via Resend,
# you must verify a custom domain at https://resend.com/domains.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=HireRank

# ── Google OAuth (Sign-in with Google) ────────────────────────────────────────
# Get Client ID & Secret from Google Cloud Console: Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Generative Interview Question Generation (OpenAI API) ────────────────────
# Get API key from https://platform.openai.com/api-keys
# If blank, HireRank automatically falls back to deterministic technical questions.
OPENAI_API_KEY=
